rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dati privati di ogni utente: diario, peso, frigo, ricette, profilo...
    // Solo il proprietario autenticato puo' leggerli o scriverli.
    match /users/{uid}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ricette condivise nella community (funzione "condividi proposta"):
    // leggibili e scrivibili da qualunque utente autenticato.
    match /shared/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
